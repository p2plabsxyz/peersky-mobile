{
  "private": true,
  "name": "peersky-mobile",
  "description": "PeerSky Browser for iOS and Android",
  "main": "expo-router/entry",
  "scripts": {
    "bundle:bare": "bare-pack --host android-arm64 --host android-arm --host android-ia32 --host android-x64 --host ios-arm64 --host ios-arm64-simulator --host ios-x64-simulator --linked --out app/app.bundle.mjs backend/backend.mjs",
    "start": "expo start",
    "preandroid": "npm run bundle:bare",
    "android": "expo run:android",
    "preios": "npm run bundle:bare",
    "ios": "expo run:ios",
    "lint": "standard"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2plabsxyz/peersky-mobile.git"
  },
  "author": "Akhilesh Thite <akhileshthite@hotmail.com> (https://akhilesh.art/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/p2plabsxyz/peersky-mobile/issues"
  },
  "homepage": "https://github.com/p2plabsxyz/peersky-mobile#readme",
  "dependencies": {
    "b4a": "^1.6.7",
    "bare-rpc": "^0.2.13",
    "expo": "~55.0.23",
    "expo-build-properties": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "^55.0.23",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-system-ui": "~55.0.17",
    "holesail": "^2.4.1",
    "hyper-sdk": "^6.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-b4a": "^0.0.4",
    "react-native-bare-kit": "^0.13.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@expo/cli": "^56.1.12",
    "@types/b4a": "^1.6.5",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "bare-pack": "^2.0.1",
    "standard": "^17.1.0",
    "typescript": "^5.3.3"
  }
}
