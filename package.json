{
  "private": true,
  "name": "peersky-mobile",
  "description": "PeerSky Browser for iOS and Android",
  "main": "expo-router/entry",
  "scripts": {
    "generate:katex-runtime": "node scripts/generate-katex-runtime.mjs",
    "generate:ieee-runtime": "node scripts/generate-ieee-runtime.mjs",
    "generate:yjs-runtime": "node scripts/generate-yjs-runtime.mjs",
    "update:peerchat-moderation-data": "node scripts/update-peerchat-moderation-data.mjs",
    "setup:content-blocking": "node scripts/setup-content-blocking.mjs",
    "eas-build-pre-install": "node scripts/setup-content-blocking.mjs --eas && node scripts/update-content-blocking-snapshot.mjs",
    "eas-build-post-install": "npm run bundle:bare",
    "update:content-blocking-snapshot": "node scripts/update-content-blocking-snapshot.mjs",
    "bundle:bare": "npm run update:content-blocking-snapshot && npm run generate:yjs-runtime && npm run generate:katex-runtime && npm run generate:ieee-runtime && npm run generate:peertunes-runtime && bare-pack --host android-arm64 --host android-arm --host android-ia32 --host android-x64 --host ios-arm64 --host ios-arm64-simulator --host ios-x64-simulator --imports backend/bare-imports.json --linked --out app/app.bundle.mjs backend/backend.mjs",
    "start": "expo start",
    "preandroid": "npm run bundle:bare",
    "android": "expo run:android",
    "preios": "npm run bundle:bare",
    "ios": "expo run:ios",
    "lint": "standard",
    "postinstall": "patch-package",
    "test": "npm run test:bundle && npm run test:runtime",
    "test:runtime": "node --test ./test/protocol/*.test.mjs ./test/platform/*.test.mjs",
    "test:bundle": "npm run bundle:bare",
    "test:holesail:live": "node --test --test-force-exit ./test/integration/holesail-live.test.mjs",
    "generate:peertunes-runtime": "node scripts/generate-peertunes-runtime.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2plabsxyz/peersky-mobile.git"
  },
  "author": "Akhilesh Thite <akhileshthite@hotmail.com> (https://akhilesh.art/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/p2plabsxyz/peersky-mobile/issues"
  },
  "homepage": "https://github.com/p2plabsxyz/peersky-mobile#readme",
  "dependencies": {
    "@bacons/apple-targets": "~5.0.0",
    "@p2plabs/hyperdht-mdns": "^1.3.0",
    "@preeternal/react-native-cookie-manager": "^6.4.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "b4a": "^1.6.7",
    "bare-abort-controller": "^1.1.2",
    "bare-buffer": "^3.7.0",
    "bare-crypto": "^1.14.0",
    "bare-dgram": "^1.0.1",
    "bare-dns": "^2.1.4",
    "bare-events": "^2.9.1",
    "bare-fetch": "^2.9.1",
    "bare-fs": "4.7.1",
    "bare-http1": "^4.5.7",
    "bare-net": "^2.3.3",
    "bare-os": "^3.9.3",
    "bare-process": "^4.5.1",
    "bare-rpc": "^0.2.13",
    "bare-stream": "2.13.1",
    "bare-zlib": "^1.4.1",
    "bonjour-service": "^1.4.4",
    "compact-encoding": "^2.19.2",
    "expo": "~55.0.23",
    "expo-audio": "~55.0.16",
    "expo-build-properties": "~55.0.9",
    "expo-camera": "~55.0.21",
    "expo-constants": "~55.0.7",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-document-picker": "~55.0.16",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.16",
    "expo-network": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-print": "~55.0.19",
    "expo-router": "~55.0.17",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.25",
    "expo-system-ui": "~55.0.20",
    "expo-video": "~55.0.21",
    "hyper-sdk": "^6.2.2",
    "hypercore-fetch": "^10.2.0",
    "hyperdht": "^6.32.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.2",
    "protomux": "^3.11.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-b4a": "^0.0.4",
    "react-native-bare-kit": "^0.13.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-webview": "13.16.0",
    "sodium-native": "^5.1.0",
    "yjs": "^13.6.31",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@types/b4a": "^1.6.5",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "bare-pack": "^2.0.1",
    "esbuild": "^0.28.1",
    "holesail": "^2.4.1",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.3",
    "standard": "^17.1.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "hyper-cmd-lib-keys": "^0.2.0"
  },
  "standard": {
    "ignore": [
      "app/app.bundle.mjs",
      "backend/peerchat/moderation-data.mjs",
      "backend/p2pmd/ieee-runtime.mjs",
      "backend/p2pmd/katex-runtime.mjs",
      "app/privacy/generated/*.mjs",
      "assets/peertunes/**",
      "backend/peertunes/peertunes-runtime.mjs"
    ]
  }
}
