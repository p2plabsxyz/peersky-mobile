diff --git a/node_modules/expo-camera/android/src/main/java/expo/modules/camera/analyzers/ZxingBarcodeAnalyzer.kt b/node_modules/expo-camera/android/src/main/java/expo/modules/camera/analyzers/ZxingBarcodeAnalyzer.kt
