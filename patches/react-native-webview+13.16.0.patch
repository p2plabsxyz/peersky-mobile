+    private void askSite(String what, String origin, Runnable allow, Runnable block) {
+        Activity activity = this.mWebView.getThemedReactContext().getCurrentActivity();
+        if (activity == null || activity.isFinishing()) {
+            block.run();
+            return;
+        }
+        Uri uri = Uri.parse(origin);
+        String site = uri.getHost() != null && !uri.getHost().isEmpty() ? uri.getHost() : origin;
+        activity.runOnUiThread(() -> {
+            final boolean[] answered = { false };
+            new AlertDialog.Builder(activity)
+                .setTitle("Allow \"" + what + "\"?")
+                .setMessage(site)
+                .setNegativeButton("Block", (dialog, which) -> {
+                    answered[0] = true;
+                    block.run();
+                })
+                .setPositiveButton("Allow", (dialog, which) -> {
+                    answered[0] = true;
+                    allow.run();
+                })
+                .setOnDismissListener((dialog) -> {
+                    if (!answered[0]) block.run();
+                })
+                .show();
+        });
+    }
