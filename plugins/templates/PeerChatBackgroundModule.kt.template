package __PACKAGE_NAME__

import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.content.IntentFilter
import android.net.Uri
import android.os.Build
import android.os.PowerManager
import android.provider.Settings
import android.media.AudioAttributes
import android.media.SoundPool
import androidx.core.content.ContextCompat
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod
import com.facebook.react.modules.core.DeviceEventManagerModule

class PeerChatBackgroundModule(
  reactContext: ReactApplicationContext
) : ReactContextBaseJavaModule(reactContext) {
  @Volatile private var listenerCount = 0
  private val soundLock = Any()
  private var receiverRegistered = false
  private var soundPool: SoundPool? = null
  private val soundIds = mutableMapOf<String, Int>()
  private val loadedSoundIds = mutableSetOf<Int>()
  private val pendingSounds = mutableSetOf<String>()

  private val tickReceiver = object : BroadcastReceiver() {
    override fun onReceive(context: Context?, intent: Intent?) {
      if (intent?.action != PeerChatBackgroundService.ACTION_TICK || listenerCount <= 0) return
      if (!reactApplicationContext.hasActiveReactInstance()) return
      reactApplicationContext
        .getJSModule(DeviceEventManagerModule.RCTDeviceEventEmitter::class.java)
        .emit(TICK_EVENT, null)
    }
  }

  override fun getName(): String = "PeerChatBackground"

  override fun initialize() {
    super.initialize()
    ContextCompat.registerReceiver(
      reactApplicationContext,
      tickReceiver,
      IntentFilter(PeerChatBackgroundService.ACTION_TICK),
      ContextCompat.RECEIVER_NOT_EXPORTED
    )
    receiverRegistered = true

    val attributes = AudioAttributes.Builder()
      .setUsage(AudioAttributes.USAGE_ASSISTANCE_SONIFICATION)
      .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
      .build()
    soundPool = SoundPool.Builder()
      .setMaxStreams(2)
      .setAudioAttributes(attributes)
      .build()
      .also { pool ->
        pool.setOnLoadCompleteListener { loadedPool, soundId, status ->
          if (status != 0) return@setOnLoadCompleteListener
          val shouldPlay = synchronized(soundLock) {
            loadedSoundIds.add(soundId)
            val kind = soundIds.entries.firstOrNull { it.value == soundId }?.key
              ?: return@synchronized false
            pendingSounds.remove(kind)
          }
          if (shouldPlay) loadedPool.play(soundId, 1f, 1f, 1, 0, 1f)
        }
        soundIds["send"] = pool.load(reactApplicationContext, R.raw.peerchat_send, 1)
        soundIds["receive"] = pool.load(reactApplicationContext, R.raw.peerchat_receive, 1)
        soundIds["pop"] = pool.load(reactApplicationContext, R.raw.peerchat_pop, 1)
      }
  }

  @ReactMethod
  fun setEnabled(enabled: Boolean, promise: Promise) {
    try {
      val intent = Intent(reactApplicationContext, PeerChatBackgroundService::class.java)
      if (enabled) {
        ContextCompat.startForegroundService(reactApplicationContext, intent)
      } else {
        PeerChatBackgroundService.setWanted(reactApplicationContext, false)
        reactApplicationContext.stopService(intent)
      }
      promise.resolve(null)
    } catch (error: Exception) {
      promise.reject("ERR_PEERCHAT_BACKGROUND", error.message, error)
    }
  }

  // Doze alone would let a foreground service through. Samsung's own layer on
  // top of it does not, which is why this is asked for separately.
  @ReactMethod
  fun isIgnoringBatteryOptimizations(promise: Promise) {
    try {
      if (Build.VERSION.SDK_INT < Build.VERSION_CODES.M) {
        promise.resolve(true)
        return
      }
      val power = reactApplicationContext.getSystemService(PowerManager::class.java)
      promise.resolve(power.isIgnoringBatteryOptimizations(reactApplicationContext.packageName))
    } catch (error: Exception) {
      promise.reject("ERR_PEERCHAT_BATTERY", error.message, error)
    }
  }

  @ReactMethod
  fun openBatteryOptimizationSettings(promise: Promise) {
    try {
      // The app-specific request dialog needs REQUEST_IGNORE_BATTERY_OPTIMIZATIONS,
      // which Play restricts. The system list is the allowed route and lands the
      // user one tap away.
      startExternal(Intent(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS))
      promise.resolve(null)
    } catch (error: Exception) {
      // Not every build ships that screen. The app's own settings page always
      // exists and has the battery entry one tap in.
      try {
        startExternal(
          Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS)
            .setData(Uri.parse("package:" + reactApplicationContext.packageName))
        )
        promise.resolve(null)
      } catch (fallbackError: Exception) {
        promise.reject("ERR_PEERCHAT_BATTERY", fallbackError.message, fallbackError)
      }
    }
  }

  private fun startExternal(intent: Intent) {
    val activity = reactApplicationContext.currentActivity
    if (activity != null) {
      activity.startActivity(intent)
      return
    }
    // No activity means no task to attach to, so the intent needs its own.
    reactApplicationContext.applicationContext
      .startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
  }

  @ReactMethod
  fun playSound(kind: String) {
    val soundId = soundIds[kind] ?: return
    val pool = soundPool ?: return
    val loaded = synchronized(soundLock) {
      if (!loadedSoundIds.contains(soundId)) pendingSounds.add(kind)
      loadedSoundIds.contains(soundId)
    }
    if (loaded) {
      pool.play(soundId, 1f, 1f, 1, 0, 1f)
    }
  }

  @ReactMethod
  fun addListener(eventName: String) {
    if (eventName == TICK_EVENT) listenerCount += 1
  }

  @ReactMethod
  fun removeListeners(count: Int) {
    listenerCount = (listenerCount - count).coerceAtLeast(0)
  }

  override fun invalidate() {
    if (receiverRegistered) {
      try {
        reactApplicationContext.unregisterReceiver(tickReceiver)
      } catch (_: IllegalArgumentException) {}
      receiverRegistered = false
    }
    soundPool?.release()
    soundPool = null
    synchronized(soundLock) {
      loadedSoundIds.clear()
      pendingSounds.clear()
    }
    super.invalidate()
  }

  companion object {
    private const val TICK_EVENT = "PeerChatBackgroundTick"
  }
}
