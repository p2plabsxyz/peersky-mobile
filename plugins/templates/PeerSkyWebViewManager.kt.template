package __PACKAGE_NAME__

import android.annotation.SuppressLint
import android.app.AlertDialog
import android.os.Handler
import android.os.Looper
import android.text.format.Formatter
import android.util.Log
import android.view.MotionEvent
import android.webkit.CookieManager
import android.webkit.WebView
import android.widget.Toast
import androidx.webkit.ProfileStore
import androidx.webkit.WebViewCompat
import androidx.webkit.WebViewFeature
import com.facebook.react.bridge.ReadableArray
import com.facebook.react.uimanager.annotations.ReactProp
import com.facebook.react.uimanager.ThemedReactContext
import com.facebook.react.uimanager.ViewManagerDelegate
import com.reactnativecommunity.webview.RNCWebViewManager
import com.reactnativecommunity.webview.RNCWebViewWrapper
import org.json.JSONObject
import java.net.URI
import java.util.WeakHashMap

class PeerSkyWebViewManager : RNCWebViewManager() {
  private val mediaLongPressTokens = WeakHashMap<WebView, String>()
  private val mediaLongPressPoints = WeakHashMap<WebView, TouchPoint>()
  private val contentBlockerBridges = WeakHashMap<WebView, PeerSkyContentBlockerBridge>()
  private val privateWebViews = WeakHashMap<WebView, String>()

  override fun getName() = "PeerSkyWebView"

  override fun getDelegate(): ViewManagerDelegate<RNCWebViewWrapper> {
    val inheritedDelegate = checkNotNull(super.getDelegate())
    return object : ViewManagerDelegate<RNCWebViewWrapper> {
      override fun setProperty(view: RNCWebViewWrapper, propName: String, value: Any?) {
        if (propName == "mediaLongPressToken") {
          setMediaLongPressToken(view, value as? String)
        } else if (propName == "contentBlockingToken") {
          setContentBlockingToken(view, value as? String)
        } else if (propName == "incognitoSession") {
          setIncognitoSession(view, value as? String)
        } else {
          inheritedDelegate.setProperty(view, propName, value)
        }
      }

      override fun receiveCommand(
        view: RNCWebViewWrapper,
        commandName: String,
        args: ReadableArray
      ) {
        inheritedDelegate.receiveCommand(view, commandName, args)
      }
    }
  }

  override fun addEventEmitters(
    context: ThemedReactContext,
    view: RNCWebViewWrapper
  ) {
    super.addEventEmitters(context, view)
    view.webView.webViewClient = PeerSkyWebViewClient()
  }

  // Every WebView shares one cookie jar, cache and storage, so incognito tabs
  // run in a WebView profile of their own. It has to be set before the page
  // loads, which is why it is a prop rather than a command. The app names a
  // session for each run of incognito tabs and keeps it while any is open, so
  // a WebView built again for the same tab, as going back does, finds its
  // cookies. Guessing a new run from no incognito WebView being left emptied
  // the profile whenever the old WebView went before the new one came.
  @ReactProp(name = "incognitoSession")
  fun setIncognitoSession(wrapper: RNCWebViewWrapper, session: String?) {
    if (!isValidToken(session) || !WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE)) return
    val webView = wrapper.webView
    if (privateWebViews.containsKey(webView)) return
    val profile = "$PRIVATE_PROFILE-$session"
    try {
      val store = ProfileStore.getInstance()
      store.getOrCreateProfile(profile)
      WebViewCompat.setProfile(webView, profile)
      privateWebViews[webView] = profile
      deleteEarlierPrivateProfiles(store, profile)
    } catch (error: Exception) {
      Log.w(TAG, "Unable to give an incognito tab its own profile", error)
    }
  }

  // Profiles from earlier runs. One still held by a WebView on its way out
  // stays until the next incognito tab opens.
  private fun deleteEarlierPrivateProfiles(store: ProfileStore, current: String) {
    for (name in store.allProfileNames) {
      if (!name.startsWith(PRIVATE_PROFILE) || name == current) continue
      try {
        store.deleteProfile(name)
      } catch (error: Exception) {
      }
    }
  }

  // The cookies of an incognito tab's own profile, which its downloads send
  // instead of the ones every other tab shares.
  private fun profileCookies(webView: WebView): CookieManager? = try {
    WebViewCompat.getProfile(webView).cookieManager
  } catch (error: Exception) {
    null
  }

  override fun onDropViewInstance(view: RNCWebViewWrapper) {
    privateWebViews.remove(view.webView)
    super.onDropViewInstance(view)
  }

  @ReactProp(name = "mediaLongPressToken")
  fun setMediaLongPressToken(wrapper: RNCWebViewWrapper, token: String?) {
    val webView = wrapper.webView
    if (isValidToken(token)) {
      mediaLongPressTokens[webView] = token!!
    } else {
      mediaLongPressTokens.remove(webView)
    }
  }

  @ReactProp(name = "contentBlockingToken")
  fun setContentBlockingToken(wrapper: RNCWebViewWrapper, token: String?) {
    contentBlockerBridges[wrapper.webView]?.setToken(token?.takeIf(::isValidToken))
  }

  @SuppressLint("ClickableViewAccessibility")
  public override fun createViewInstance(
    context: ThemedReactContext
  ): RNCWebViewWrapper {
    val wrapper = super.createViewInstance(context)
    val contentBlockerBridge = PeerSkyContentBlockerBridge()
    contentBlockerBridges[wrapper.webView] = contentBlockerBridge
    wrapper.webView.addJavascriptInterface(
      contentBlockerBridge,
      "PeerSkyContentBlocker"
    )
    wrapper.webView.setDownloadListener {
        url,
        userAgent,
        contentDisposition,
        mimeType,
        contentLength ->
      val downloads = context.getNativeModule(BrowserDownloadsModule::class.java)
      if (downloads == null) {
        Toast.makeText(
          context,
          "Download service is unavailable.",
          Toast.LENGTH_LONG
        ).show()
        return@setDownloadListener
      }
      val name = downloads.resolveFilename(url, contentDisposition, mimeType)
      val incognito = privateWebViews.containsKey(wrapper.webView)
      // Read now: the profile is only reachable from the UI thread.
      val incognitoCookies = if (incognito) profileCookies(wrapper.webView) else null
      confirmDownload(context, name, url, contentLength) {
        downloads.queueDownload(
          url,
          userAgent,
          contentDisposition,
          mimeType,
          incognito,
          incognitoCookies
        )
      }
    }
    wrapper.webView.setOnLongClickListener {
      handleLongPress(wrapper.webView)
    }
    wrapper.webView.setOnTouchListener { _, event ->
      val webView = wrapper.webView
      when (event.actionMasked) {
        MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE -> {
          if (webView.width > 0 && webView.height > 0) {
            mediaLongPressPoints[webView] = TouchPoint(
              (event.x / webView.width).toDouble().coerceIn(0.0, 1.0),
              (event.y / webView.height).toDouble().coerceIn(0.0, 1.0)
            )
          }
        }
        MotionEvent.ACTION_UP -> {
          mediaLongPressPoints.remove(webView)
        }
      }
      false
    }
    return wrapper
  }

  // A page can start a download without a tap, so nothing is saved until the
  // person says yes.
  private fun confirmDownload(
    context: ThemedReactContext,
    name: String,
    url: String,
    contentLength: Long,
    onConfirm: () -> Unit
  ) {
    val activity = context.currentActivity
    if (activity == null || activity.isFinishing) return
    val host = try { URI(url).host } catch (error: Exception) { null }
    val details = listOfNotNull(
      if (contentLength > 0) "$name, ${Formatter.formatShortFileSize(activity, contentLength)}" else name,
      host?.let { "from $it" }
    ).joinToString("\n")
    AlertDialog.Builder(activity)
      .setTitle("Download this file?")
      .setMessage(details)
      .setNegativeButton("Cancel", null)
      .setPositiveButton("Download") { _, _ -> onConfirm() }
      .show()
  }

  private fun handleLongPress(webView: WebView): Boolean {
    val result = webView.hitTestResult
    return when (result.type) {
      WebView.HitTestResult.IMAGE_TYPE -> {
        val handled = dispatchTarget(
          webView = webView,
          kind = "image",
          mediaUrl = result.extra
        )
        handled || dispatchDomTarget(webView)
      }
      WebView.HitTestResult.SRC_IMAGE_ANCHOR_TYPE -> {
        val touchPoint = mediaLongPressPoints[webView]
        val message = Handler(Looper.getMainLooper()) { response ->
          val handled = dispatchTarget(
            webView = webView,
            kind = "image",
            mediaUrl = response.data.getString("src"),
            linkUrl = response.data.getString("url"),
            title = response.data.getString("title")
          )
          if (!handled) dispatchDomTarget(webView, touchPoint)
          true
        }.obtainMessage()
        webView.requestFocusNodeHref(message)
        true
      }
      WebView.HitTestResult.SRC_ANCHOR_TYPE -> {
        val handled = dispatchTarget(
          webView = webView,
          kind = "link",
          linkUrl = result.extra
        )
        handled || dispatchDomTarget(webView)
      }
      // A text field keeps its own long press: the cursor, selecting and Paste.
      WebView.HitTestResult.EDIT_TEXT_TYPE -> false
      // Text, and anything else, goes on to the WebView, which selects it. The
      // page is still asked whether a video or picture is under the finger.
      // Answering true here took every long press, so no text on a page could
      // be selected and no field offered Paste.
      else -> {
        dispatchDomTarget(webView)
        false
      }
    }
  }

  private fun dispatchDomTarget(
    webView: WebView,
    touchPoint: TouchPoint? = mediaLongPressPoints[webView]
  ): Boolean {
    val token = mediaLongPressTokens[webView] ?: return false
    val point = touchPoint ?: return false
    val javascript = "window.__peerskyResolveMediaLongPressAt?.(" +
      JSONObject.quote(token) + "," + point.xRatio + "," + point.yRatio + ");"
    webView.evaluateJavascript(javascript, null)
    return true
  }

  private fun dispatchTarget(
    webView: WebView,
    kind: String,
    mediaUrl: String? = null,
    linkUrl: String? = null,
    title: String? = null
  ): Boolean {
    val token = mediaLongPressTokens[webView] ?: return false
    val normalizedMediaUrl = normalizeTargetUrl(mediaUrl, MEDIA_SCHEMES)
    val normalizedLinkUrl = normalizeTargetUrl(linkUrl, LINK_SCHEMES)

    if (kind == "image" && normalizedMediaUrl == null) return false
    if (kind == "link" && normalizedLinkUrl == null) return false

    val payload = JSONObject()
      .put("type", MESSAGE_TYPE)
      .put("token", token)
      .put("kind", kind)
      .put("mediaUrl", normalizedMediaUrl)
      .put("linkUrl", normalizedLinkUrl)
      .put("title", normalizeTitle(title))

    val javascript = "if (window.ReactNativeWebView) { " +
      "window.ReactNativeWebView.postMessage(" +
      JSONObject.quote(payload.toString()) + "); }"
    webView.evaluateJavascript(javascript, null)
    return true
  }

  private fun normalizeTargetUrl(value: String?, schemes: Set<String>): String? {
    val candidate = value?.trim()?.takeIf {
      it.isNotEmpty() &&
        it.length <= MAX_URL_LENGTH &&
        it.none { character -> character.code < 32 || character.code in 127..159 }
    } ?: return null

    return try {
      val parsed = URI(candidate)
      candidate.takeIf {
        parsed.scheme?.lowercase() in schemes &&
          !parsed.host.isNullOrBlank() &&
          parsed.userInfo == null
      }
    } catch (_: Exception) {
      null
    }
  }

  private fun normalizeTitle(value: String?): String {
    return value
      ?.filter { it.code >= 32 && it.code !in 127..159 }
      ?.trim()
      ?.take(MAX_TITLE_LENGTH)
      .orEmpty()
  }

  companion object {
    private const val TAG = "PeerSkyWebView"
    private const val PRIVATE_PROFILE = "peersky-incognito"
    private const val MESSAGE_TYPE = "peersky-browser-media-long-press"
    private const val MAX_URL_LENGTH = 8192
    private const val MAX_TITLE_LENGTH = 256
    private const val TOKEN_LENGTH = 32
    private val MEDIA_SCHEMES = setOf("http", "https")
    private val LINK_SCHEMES = setOf("http", "https", "hyper", "peersky")

    internal fun isValidToken(value: String?): Boolean =
      value?.length == TOKEN_LENGTH && value.all { it in '0'..'9' || it in 'a'..'f' }
  }

  private data class TouchPoint(val xRatio: Double, val yRatio: Double)
}
