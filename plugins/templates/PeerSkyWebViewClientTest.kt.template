package __PACKAGE_NAME__

import org.junit.Assert.assertFalse
import org.junit.Assert.assertTrue
import org.junit.Test

class PeerSkyWebViewClientTest {
  @Test
  fun identifiesOnlyRemoteHttpUrls() {
    assertTrue(isRemoteHttpUrl("https", "example.com"))
    assertTrue(isRemoteHttpUrl("HTTP", "EXAMPLE.COM"))
    assertFalse(isRemoteHttpUrl("file", "example.com"))
    assertFalse(isRemoteHttpUrl("https", null))
    assertFalse(isRemoteHttpUrl("https", "localhost"))
    assertFalse(isRemoteHttpUrl("https", "127.0.0.1"))
    assertFalse(isRemoteHttpUrl("https", "10.0.2.2"))
    assertFalse(isRemoteHttpUrl("https", "::1"))
  }

  @Test
  fun identifiesOnlyThePinnedYoutubeAdBreakRequest() {
    assertTrue(isYoutubeAdBreakRequest(
      "https",
      "www.youtube.com",
      "/youtubei/v1/player/ad_break",
      "https",
      "m.youtube.com"
    ))
    assertTrue(isYoutubeAdBreakRequest(
      "https",
      "www.youtube-nocookie.com",
      "/youtubei/v1/player/ad_break",
      "https",
      "youtube-nocookie.com"
    ))
    assertFalse(isYoutubeAdBreakRequest(
      "https",
      "youtube.com.evil.test",
      "/youtubei/v1/player/ad_break",
      "https",
      "youtube.com"
    ))
    assertFalse(isYoutubeAdBreakRequest(
      "https",
      "youtube.com",
      "/watch",
      "https",
      "youtube.com"
    ))
    assertFalse(isYoutubeAdBreakRequest(
      "http",
      "youtube.com",
      "/youtubei/v1/player/ad_break",
      "https",
      "youtube.com"
    ))
  }
}
