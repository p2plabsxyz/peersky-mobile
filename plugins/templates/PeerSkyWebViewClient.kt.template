package __PACKAGE_NAME__

import android.graphics.Bitmap
import android.net.Uri
import android.webkit.JavascriptInterface
import android.webkit.WebResourceRequest
import android.webkit.WebResourceResponse
import android.webkit.WebView
import com.reactnativecommunity.webview.RNCWebViewClient
import java.io.ByteArrayInputStream
import java.util.Locale
import java.util.concurrent.atomic.AtomicReference

internal fun isRemoteHttpUrl(scheme: String?, host: String?): Boolean {
  val normalizedScheme = scheme?.lowercase(Locale.ROOT)
  val normalizedHost = host?.lowercase(Locale.ROOT) ?: return false
  return (normalizedScheme == "http" || normalizedScheme == "https") &&
    normalizedHost !in setOf("localhost", "::1", "10.0.2.2") &&
    !normalizedHost.startsWith("127.")
}

internal fun isYoutubeAdBreakRequest(
  requestScheme: String?,
  requestHost: String?,
  requestPath: String?,
  documentScheme: String?,
  documentHost: String?
): Boolean {
  fun isYoutubeHost(value: String?): Boolean {
    val host = value?.lowercase(Locale.ROOT) ?: return false
    return host == "youtube.com" || host.endsWith(".youtube.com")
  }

  return requestScheme.equals("https", ignoreCase = true) &&
    documentScheme.equals("https", ignoreCase = true) &&
    isYoutubeHost(requestHost) &&
    isYoutubeHost(documentHost) &&
    requestPath == "/youtubei/v1/player/ad_break"
}

class PeerSkyWebViewClient : RNCWebViewClient() {
  private val documentUrl = AtomicReference("")

  override fun onPageStarted(view: WebView, url: String, favicon: Bitmap?) {
    documentUrl.set(url)
    super.onPageStarted(view, url, favicon)
  }

  override fun shouldInterceptRequest(
    view: WebView,
    request: WebResourceRequest
  ): WebResourceResponse? {
    if (shouldBlock(request)) return blockedResponse()
    return super.shouldInterceptRequest(view, request)
  }

  private fun shouldBlock(request: WebResourceRequest): Boolean {
    if (request.isForMainFrame) return false
    val requestUri = request.url ?: return false
    if (!isRemoteHttpUrl(requestUri)) return false

    val requestUrl = requestUri.toString()
    if (requestUrl.length > MAX_FILTER_URL_LENGTH) return false
    val pageUrl = documentUrl.get()
    if (pageUrl.isBlank() || pageUrl.length > MAX_FILTER_URL_LENGTH) return false
    if (!isRemoteHttpUrl(Uri.parse(pageUrl))) return false
    if (PeerSkyYoutubeAdBlocker.shouldBlock(requestUri, Uri.parse(pageUrl))) return true
    return PeerSkyAdBlockEngine.shouldBlock(
      requestUrl,
      pageUrl,
      detectResourceType(request),
      request.method ?: "GET"
    )
  }

  companion object {
    private const val MAX_FILTER_URL_LENGTH = 16 * 1024
    private fun isRemoteHttpUrl(uri: Uri): Boolean {
      return isRemoteHttpUrl(uri.scheme, uri.host)
    }

    private fun detectResourceType(request: WebResourceRequest): String {
      val headers = request.requestHeaders.entries.associate {
        it.key.lowercase(Locale.ROOT) to it.value
      }
      val accept = headers["accept"]?.lowercase(Locale.ROOT).orEmpty()
      if (accept.contains("javascript")) return "script"
      if (accept.contains("text/css")) return "stylesheet"
      if (accept.contains("image/")) return "image"
      if (accept.contains("font/")) return "font"
      if (accept.contains("audio/") || accept.contains("video/")) return "media"
      if (headers["x-requested-with"] == "XMLHttpRequest") return "xhr"

      return when (request.url.lastPathSegment
        ?.substringAfterLast('.', "")
        ?.lowercase(Locale.ROOT)) {
        "js", "mjs" -> "script"
        "css" -> "stylesheet"
        "png", "jpg", "jpeg", "gif", "svg", "webp", "ico" -> "image"
        "ttf", "otf", "woff", "woff2" -> "font"
        "mp3", "mp4", "m4a", "ogg", "ogv", "webm", "wav" -> "media"
        else -> "other"
      }
    }

    private fun blockedResponse() = WebResourceResponse(
      "text/plain",
      "UTF-8",
      204,
      "No Content",
      emptyMap(),
      ByteArrayInputStream(ByteArray(0))
    )
  }
}

object PeerSkyYoutubeAdBlocker {
  @Volatile
  var enabled = true

  fun shouldBlock(request: Uri, document: Uri): Boolean {
    if (!enabled) return false
    return isYoutubeAdBreakRequest(
      request.scheme,
      request.host,
      request.path,
      document.scheme,
      document.host
    )
  }
}

class PeerSkyContentBlockerBridge {
  @JavascriptInterface
  fun shouldBlock(
    requestUrl: String?,
    documentUrl: String?,
    resourceType: String?,
    method: String?
  ): Boolean {
    val normalizedRequestUrl = normalizeRemoteHttpUrl(requestUrl) ?: return false
    val normalizedDocumentUrl = normalizeRemoteHttpUrl(documentUrl) ?: return false
    return PeerSkyAdBlockEngine.shouldBlock(
      normalizedRequestUrl,
      normalizedDocumentUrl,
      normalizeResourceType(resourceType),
      normalizeMethod(method)
    )
  }

  private fun normalizeRemoteHttpUrl(value: String?): String? {
    val candidate = value
      ?.trim()
      ?.takeIf {
        it.isNotBlank() &&
          it.length <= MAX_FILTER_URL_LENGTH &&
          it.none { character -> character.code < 32 || character.code in 127..159 }
      } ?: return null

    return try {
      val parsed = Uri.parse(candidate)
      candidate.takeIf { isRemoteHttpUrl(parsed) }
    } catch (_: Exception) {
      null
    }
  }

  private fun normalizeResourceType(value: String?): String {
    return when (value?.lowercase(Locale.ROOT)) {
      "xhr", "xmlhttprequest", "fetch" -> "xhr"
      "script" -> "script"
      "stylesheet" -> "stylesheet"
      "image" -> "image"
      "font" -> "font"
      "media" -> "media"
      else -> "other"
    }
  }

  private fun normalizeMethod(value: String?): String {
    val method = value?.uppercase(Locale.ROOT).orEmpty()
    return method.takeIf { it.matches(Regex("[A-Z]{1,16}")) } ?: "GET"
  }

  companion object {
    private const val MAX_FILTER_URL_LENGTH = 16 * 1024

    private fun isRemoteHttpUrl(uri: Uri): Boolean {
      return isRemoteHttpUrl(uri.scheme, uri.host)
    }
  }
}
