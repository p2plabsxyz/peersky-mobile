package __PACKAGE_NAME__

import android.content.ComponentName
import android.content.pm.PackageManager
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod

/**
 * Changes the launcher icon. Android has no API for this, only one
 * activity-alias per icon with all but one disabled. Switching enables the new
 * alias before disabling the rest, since with none enabled the app is missing
 * from the launcher.
 */
class PeerSkyAppIconModule(
  reactContext: ReactApplicationContext
) : ReactContextBaseJavaModule(reactContext) {

  override fun getName() = "PeerSkyAppIcon"

  /**
   * Re-enables MainActivity. An earlier build disabled it to hide the launcher
   * entry, which broke anything starting the app by class name (the dev
   * launcher, deep links). Component state belongs to the package, so it
   * survives reinstalls, and adb cannot reset it because only the app may
   * change its own components.
   */
  override fun initialize() {
    super.initialize()

    try {
      val manager = reactApplicationContext.packageManager
      val main = ComponentName(
        reactApplicationContext.packageName,
        "${reactApplicationContext.packageName}.MainActivity"
      )
      if (manager.getComponentEnabledSetting(main) ==
        PackageManager.COMPONENT_ENABLED_STATE_DISABLED
      ) {
        manager.setComponentEnabledSetting(
          main,
          PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
          PackageManager.DONT_KILL_APP
        )
      }
    } catch (error: Exception) {
      // Nothing to do about it here, and it must not stop the app starting.
    }
  }

  private fun aliasFor(name: String): String {
    val packageName = reactApplicationContext.packageName
    return "$packageName.MainActivity${name.replaceFirstChar { it.uppercase() }}"
  }

  private fun componentsFor(names: List<String>) = names.map {
    ComponentName(reactApplicationContext.packageName, aliasFor(it))
  }

  @ReactMethod
  fun getIcon(promise: Promise) {
    try {
      val manager = reactApplicationContext.packageManager
      val enabled = ALIASES.firstOrNull { name ->
        val component = ComponentName(reactApplicationContext.packageName, aliasFor(name))
        manager.getComponentEnabledSetting(component) ==
          PackageManager.COMPONENT_ENABLED_STATE_ENABLED
      }
      promise.resolve(enabled ?: DEFAULT_ALIAS)
    } catch (error: Exception) {
      promise.reject("failed", error.message, error)
    }
  }

  @ReactMethod
  fun setIcon(name: String?, promise: Promise) {
    val manager = reactApplicationContext.packageManager
    // Every colour is an alias, the activity itself is never one of them. It
    // has no launcher entry to compete with and must stay enabled: disabling
    // it breaks starting the app by class name, which is how the dev launcher
    // and anything holding an explicit component start it.
    val target = name?.takeIf { ALIASES.contains(it) } ?: DEFAULT_ALIAS

    try {
      // The one that should end up on goes first. Disabling everything and
      // then enabling leaves a window with no launcher entry at all, and a
      // launcher that refreshes inside it drops the app.
      manager.setComponentEnabledSetting(
        ComponentName(reactApplicationContext.packageName, aliasFor(target)),
        PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
        PackageManager.DONT_KILL_APP
      )

      for (component in componentsFor(ALIASES.filter { it != target })) {
        manager.setComponentEnabledSetting(
          component,
          PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
          PackageManager.DONT_KILL_APP
        )
      }

      promise.resolve(true)
    } catch (error: Exception) {
      promise.reject("failed", error.message, error)
    }
  }

  companion object {
    private val ALIASES = listOf(__ALIASES__)
    private const val DEFAULT_ALIAS = __DEFAULT_ALIAS__
  }
}
