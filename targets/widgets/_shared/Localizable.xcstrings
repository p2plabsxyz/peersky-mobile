    "What is playing. The medium size has the controls." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يتم تشغيله الآن. يحتوي الحجم المتوسط على عناصر التحكم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যা চলছে তা দেখায়। মাঝারি সাইজে কন্ট্রোলও থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was gerade läuft. Die mittlere Größe hat die Steuerung."
          }
