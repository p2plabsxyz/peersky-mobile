    "Clears all P2P data and this device's identity right away, without asking." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمحو كل بيانات P2P وهوية هذا الجهاز فورًا، دون أن يسأل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু জিজ্ঞেস না করেই সব P2P ডেটা আর এই ডিভাইসের পরিচয় সঙ্গে সঙ্গে সাফ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
