    "Burns your tabs, history and cached data right away." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحرق علامات التبويب والسجل والبيانات المؤقتة فورًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ট্যাব, ইতিহাস ও ক্যাশে করা ডেটা সঙ্গে সঙ্গে পুড়িয়ে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
