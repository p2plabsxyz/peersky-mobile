    "Pages you bookmark in PeerSky show up here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر هنا الصفحات التي تضيفها إلى الإشارات المرجعية في PeerSky."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PeerSky-তে যেসব পেজ বুকমার্ক করবেন, সেগুলো এখানে দেখা যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiten, für die du in PeerSky ein Lesezeichen setzt, erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas que guardes como marcador en PeerSky aparecen aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفحه‌هایی که در PeerSky نشانک می‌کنید اینجا نمایش داده می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages que vous ajoutez aux signets dans PeerSky s’affichent ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PeerSky में बुकमार्क किए गए पेज यहाँ दिखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halaman yang Anda bookmark di PeerSky akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine che aggiungi ai segnalibri in PeerSky compaiono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PeerSkyでブックマークしたページがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PeerSky에서 북마크한 페이지가 여기에 표시돼요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PeerSky मध्ये तुम्ही बुकमार्क केलेली पेजेस इथे दिसतात."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagina's waarvoor je in PeerSky een bladwijzer maakt, verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pojawią się strony dodane do zakładek w PeerSky."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas que você adiciona aos marcadores no PeerSky aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся страницы, которые вы добавите в закладки в PeerSky."
          }
        },
        "sa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PeerSky इत्यस्मिन् भवता पुस्तकचिह्नितानि जालपुटानि अत्र दृश्यन्ते।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าเว็บที่บุ๊กมาร์กไว้ใน PeerSky จะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PeerSky'da yer işaretine eklediğiniz sayfalar burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут з'являться сторінки, які ви додасте в закладки в PeerSky."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PeerSky میں بک مارک کیے گئے صفحات یہاں دکھائی دیتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các trang bạn đánh dấu trong PeerSky sẽ hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 PeerSky 中添加书签的页面会显示在这里。"
